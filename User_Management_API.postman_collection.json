							"key": "role",
							"value": "admin",
							"disabled": true
						}
					]
				},
				"description": "Retrieves all users from MongoDB with optional pagination, search query, and filters."
			},
			"response": []
		},
		{
			"name": "Get User By ID (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
