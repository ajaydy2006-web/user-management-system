	"item": [
		{
			"name": "Seed Initial Sample Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.length > 0) {",
							"    pm.collectionVariables.set('userId', jsonData.data[0]._id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/seed",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"seed"
					]
				},
				"description": "Populates the MongoDB database with sample users for testing."
			},
			"response": []
		},
		{
			"name": "Create User (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.test('User created successfully', function () {",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.have.property('_id');",
							"});",
							"if (jsonData.data && jsonData.data._id) {",
							"    pm.collectionVariables.set('userId', jsonData.data._id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"user\",\n  \"status\": \"active\",\n  \"department\": \"Product Engineering\",\n  \"phone\": \"+1 555-0123\",\n  \"bio\": \"Senior Full Stack Developer specializing in Node.js & React.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				},
				"description": "Creates a new user record in MongoDB."
			},
			"response": []
		},
		{
			"name": "Get All Users (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.test('Returns list of users', function () {",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
